<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Top Chat Header -->
    <LinearLayout
        android:id="@+id/chatHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/surface_dark"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <LinearLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:background="@drawable/bg_pin_button">

            <TextView
                android:id="@+id/tvChatAvatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤖"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChatTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resence AI"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChatStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 Sovereign E2EE · No Screenshots"
                android:textColor="@color/emerald_400"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSecureBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️ SECURE"
            android:textColor="@color/emerald_400"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_emerald"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <!-- Messages Container -->
    <ScrollView
        android:id="@+id/messagesScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/chatHeader"
        app:layout_constraintBottom_toTopOf="@id/inputBar">

        <LinearLayout
            android:id="@+id/messagesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- System E2EE Banner -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="12dp"
                android:text="🔒 Messages in this 1-on-1 chat are end-to-end encrypted.\nScreenshots and screen recording are prohibited."
                android:textColor="@color/slate_400"
                android:textAlignment="center"
                android:textSize="11sp"
                android:background="@drawable/bg_card_dark"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Typing Indicator -->
    <TextView
        android:id="@+id/tvTypingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resence AI is thinking..."
        android:textColor="@color/emerald_400"
        android:textSize="11sp"
        android:visibility="gone"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@id/inputBar"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom Message Input Bar -->
    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="@color/surface_dark"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/btnAttachMedia"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="📎"
            android:textSize="20sp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <EditText
            android:id="@+id/etMessageInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_card_dark"
            android:hint="Sovereign encrypted message..."
            android:textColorHint="@color/slate_700"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:paddingHorizontal="14dp"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4" />

        <TextView
            android:id="@+id/btnSendMessage"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="➤"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:background="@drawable/bg_badge_emerald" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
