<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/surface_dark"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(( 🔒∞ ))"
            android:textColor="@color/emerald_400"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WeResence"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="4dp"
            android:background="@color/emerald_400" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvNetworkStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟢 ONLINE"
            android:textColor="@color/emerald_400"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_emerald"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btnLockVault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒 Lock"
            android:textColor="@color/slate_400"
            android:textSize="12sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp" />
    </LinearLayout>

    <!-- TAB 1: CHATS VIEW -->
    <ScrollView
        android:id="@+id/viewChatsTab"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Active Sovereign Peers Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Peer 1: Resence AI -->
                    <LinearLayout
                        android:id="@+id/storyResenceAi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="16dp">

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:gravity="center"
                            android:text="🤖"
                            android:textSize="22sp"
                            android:background="@drawable/bg_badge_emerald" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resence AI"
                            android:textColor="@color/slate_100"
                            android:textSize="11sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Peer 2: Piyush Singh (Founder) -->
                    <LinearLayout
                        android:id="@+id/storyPiyush"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="16dp">

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:gravity="center"
                            android:text="👑"
                            android:textSize="22sp"
                            android:background="@drawable/bg_pin_button" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Piyush (You)"
                            android:textColor="@color/slate_100"
                            android:textSize="11sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Peer 3: Sovereign Vault -->
                    <LinearLayout
                        android:id="@+id/storyVault"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:gravity="center"
                            android:text="🔒"
                            android:textSize="22sp"
                            android:background="@drawable/bg_pin_button" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Private Vault"
                            android:textColor="@color/slate_100"
                            android:textSize="11sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/slate_800" />

            <!-- CHAT LIST -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp">

                <!-- Chat Item 1: Resence AI -->
                <LinearLayout
                    android:id="@+id/chatItemResenceAi"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="🤖"
                        android:textSize="22sp"
                        android:background="@drawable/bg_badge_emerald" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resence AI"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Live ai.resence.in companion · Tap to chat"
                            android:textColor="@color/emerald_400"
                            android:textSize="12sp"
                            android:singleLine="true" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 NEW"
                        android:textColor="@color/emerald_400"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_badge_emerald"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/slate_900" />

                <!-- Chat Item 2: Sovereign Peer -->
                <LinearLayout
                    android:id="@+id/chatItemPiyush"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="🔒"
                        android:textSize="22sp"
                        android:background="@drawable/bg_pin_button" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sovereign Peer Channel"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="E2EE Envelope active · Zero cloud compression"
                            android:textColor="@color/slate_400"
                            android:textSize="12sp"
                            android:singleLine="true" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="E2EE"
                        android:textColor="@color/slate_400"
                        android:textSize="10sp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- TAB 2: VAULT / GALLERY VIEW -->
    <LinearLayout
        android:id="@+id/viewVaultTab"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️"
            android:textSize="52sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Private Sovereign Vault"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Screenshots and screen recording are strictly prohibited inside the private gallery and 1-on-1 chats to protect sovereign media."
            android:textColor="@color/slate_400"
            android:textSize="13sp"
            android:textAlignment="center"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnOpenPrivateGallery"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Open Private Gallery (Protected)"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:backgroundTint="@color/emerald_500"
            android:layout_marginTop="20dp" />
    </LinearLayout>

    <!-- TAB 3: SETTINGS & AUTH VIEW -->
    <ScrollView
        android:id="@+id/viewSettingsTab"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Supabase Phone Auth Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔑 Supabase Phone Authentication"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnOpenOnboarding"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Launch Google + Phone Auth Onboarding"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/emerald_500"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/tvSupabaseStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Project: zmpydrioaaoafgtoweai (Ready for testing)"
                    android:textColor="@color/slate_400"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />

                <EditText
                    android:id="@+id/etPhoneNumber"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:hint="Phone (e.g. +919557740764)"
                    android:textColorHint="@color/slate_700"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:inputType="phone"
                    android:background="@color/slate_900"
                    android:paddingHorizontal="12dp"
                    android:layout_marginTop="10dp" />

                <Button
                    android:id="@+id/btnSendOtp"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="Request OTP"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:backgroundTint="@color/indigo_600"
                    android:layout_marginTop="8dp" />

                <LinearLayout
                    android:id="@+id/layoutOtpVerify"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="10dp">

                    <EditText
                        android:id="@+id/etOtpCode"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:hint="Enter 6-digit OTP (e.g. 123456)"
                        android:textColorHint="@color/slate_700"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:inputType="number"
                        android:background="@color/slate_900"
                        android:paddingHorizontal="12dp" />

                    <Button
                        android:id="@+id/btnVerifyOtp"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:text="Verify &amp; Create Sovereign Session"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:backgroundTint="@color/emerald_500"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAuthResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/emerald_400"
                    android:textSize="11sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Camouflage Settings -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎭 Camouflage Decoy System"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Entering PIN 0000 transforms WeResence into harmless Resence AI (ai.resence.in). Master PIN 1234 unlocks this sovereign vault."
                    android:textColor="@color/slate_400"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />

                <Button
                    android:id="@+id/btnTestCamouflage"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="Test Decoy Mode (0000 ➜ ai.resence.in)"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:backgroundTint="@color/slate_800"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/surface_dark"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tabChats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="💬 Chats"
            android:textColor="@color/emerald_400"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/tabVault"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🛡️ Vault"
            android:textColor="@color/slate_400"
            android:textSize="12sp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⚙️ Settings"
            android:textColor="@color/slate_400"
            android:textSize="12sp"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
