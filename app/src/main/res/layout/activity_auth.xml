<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Top Header / Emblem -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(( 🔒∞ ))"
            android:textColor="@color/emerald_400"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WeResence"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="4dp"
                android:background="@color/emerald_400" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sovereign Multi-Factor Onboarding"
            android:textColor="@color/slate_400"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <!-- Mandatory Dual Verification Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_badge_emerald"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️ Mandatory Dual Identity: Google SSO + Sovereign Phone"
                android:textColor="@color/emerald_400"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- STEP 1: GOOGLE SIGN-IN CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_auth_card"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 1: Google Identity"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvGoogleStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REQUIRED"
                    android:textColor="@color/slate_400"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@color/slate_800"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Authenticate your primary Google account via Firebase OAuth."
                android:textColor="@color/slate_400"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <!-- Google Sign-In Button -->
            <LinearLayout
                android:id="@+id/btnGoogleSignIn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_google_btn"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="G"
                    android:textColor="#4285F4"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/tvGoogleBtnText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Continue with Google"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvGoogleResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/emerald_400"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- STEP 2: SOVEREIGN PHONE NUMBER CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_auth_card"
            android:padding="20dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 2: Sovereign Phone"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvPhoneStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REQUIRED"
                    android:textColor="@color/slate_400"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@color/slate_800"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100% Free Firebase SMS Verification. Auto-reads OTP on device."
                android:textColor="@color/slate_400"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <!-- Phone Input Field -->
            <EditText
                android:id="@+id/etAuthPhone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Phone (e.g. +91 95577 40764)"
                android:textColorHint="@color/slate_700"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:inputType="phone"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="14dp" />

            <Button
                android:id="@+id/btnAuthSendOtp"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Send Free SMS OTP"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_primary_btn"
                android:layout_marginTop="10dp" />

            <!-- OTP Verification Container -->
            <LinearLayout
                android:id="@+id/layoutAuthOtpVerify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="14dp">

                <EditText
                    android:id="@+id/etAuthOtpCode"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Enter 6-digit Code"
                    android:textColorHint="@color/slate_700"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:letterSpacing="0.2"
                    android:inputType="number"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="16dp" />

                <Button
                    android:id="@+id/btnAuthVerifyOtp"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="Verify &amp; Enter Sovereign Messenger"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_primary_btn"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPhoneResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/emerald_400"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Protected by Sovereign Dual-PIN Camouflage (0000 ➜ ai.resence.in)"
            android:textColor="@color/slate_700"
            android:textSize="11sp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
