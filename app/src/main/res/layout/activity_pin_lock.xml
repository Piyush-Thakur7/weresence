<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/bg_dark">

    <!-- Top Emblem / Lock -->
    <TextView
        android:id="@+id/tvVaultEmblem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="(( 🔒∞ ))"
        android:textColor="@color/emerald_400"
        android:textSize="26sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <!-- App Name -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WeResence"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="4dp"
            android:background="@color/emerald_400" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPinSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter Sovereign Security PIN"
        android:textColor="@color/slate_400"
        android:textSize="13sp"
        android:layout_marginTop="6dp" />

    <!-- 4 PIN Indicator Dots -->
    <LinearLayout
        android:id="@+id/dotsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp">

        <View
            android:id="@+id/dot1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pin_dot_empty" />

        <View
            android:id="@+id/dot2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pin_dot_empty" />

        <View
            android:id="@+id/dot3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pin_dot_empty" />

        <View
            android:id="@+id/dot4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pin_dot_empty" />
    </LinearLayout>

    <!-- Error / Hint message -->
    <TextView
        android:id="@+id/tvErrorMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/red_500"
        android:textSize="12sp"
        android:layout_marginBottom="24dp" />

    <!-- Keypad Grid -->
    <GridLayout
        android:id="@+id/keypadGrid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:alignmentMode="alignMargins"
        android:layout_gravity="center">

        <!-- Row 1: 1, 2, 3 -->
        <TextView
            android:id="@+id/btn1"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:gravity="center"
            android:background="@drawable/bg_pin_button"
            android:text="1"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn2"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:gravity="center"
            android:background="@drawable/bg_pin_button"
            android:text="2"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn3"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:gravity="center"
            android:background="@drawable/bg_pin_button"
            android:text="3"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Row 2: 4, 5, 6 -->
        <TextView
            android:id="@+id/btn4"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:gravity="center"
            android:background="@drawable/bg_pin_button"
            android:text="4"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn5"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:gravity="center"
            android:background="@drawable/bg_pin_button"
            android:text="5"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn6"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:gravity="center"
            android:background="@drawable/bg_pin_button"
            android:text="6"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Row 3: 7, 8, 9 -->
        <TextView
            android:id="@+id/btn7"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:gravity="center"
            android:background="@drawable/bg_pin_button"
            android:text="7"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn8"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:gravity="center"
            android:background="@drawable/bg_pin_button"
            android:text="8"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn9"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:gravity="center"
            android:background="@drawable/bg_pin_button"
            android:text="9"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Row 4: Empty, 0, Backspace -->
        <View
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp" />

        <TextView
            android:id="@+id/btn0"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:gravity="center"
            android:background="@drawable/bg_pin_button"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDelete"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:gravity="center"
            android:background="@drawable/bg_pin_button"
            android:text="⌫"
            android:textColor="@color/slate_400"
            android:textSize="20sp" />
    </GridLayout>

    <!-- Footer Privacy Note -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Protected by Anti-Screen Capture (FLAG_SECURE)"
        android:textColor="@color/slate_700"
        android:textSize="11sp"
        android:layout_marginTop="20dp" />

</LinearLayout>
